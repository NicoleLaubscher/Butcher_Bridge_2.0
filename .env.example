# Copy this file to .env and change every value for your environment.
FLASK_ENV=development
SECRET_KEY=change-this-before-deployment

# Required marking stack: MySQL. Create the database first with schema.sql,
# or run `flask db upgrade` against an empty database.
DATABASE_URL=mysql+pymysql://butcherbridge:change-me@127.0.0.1:3306/butcherbridge

# Set to 1 only for a quick offline classroom demo without MySQL.
USE_SQLITE_DEMO=0
LOG_LEVEL=INFO

